# Copy to .env in this directory. Credentials below are local examples only.
INTERVIEWFORGE_ENVIRONMENT=development
# Optional until database work begins. Uncomment after configuring PostgreSQL.
# INTERVIEWFORGE_DATABASE_URL=postgresql+psycopg://interviewforge:local-password@127.0.0.1:5432/interviewforge
INTERVIEWFORGE_DB_CONNECT_TIMEOUT=3

# Amazon coach configuration using Claude.
INTERVIEWFORGE_LLM_PROVIDER=anthropic
INTERVIEWFORGE_LLM_MODEL=anthropic:claude-sonnet-5
# ANTHROPIC_API_KEY=paste-your-claude-key-in-the-local-env-file

# MCP server that exposes reviewed Amazon company knowledge.
INTERVIEWFORGE_AMAZON_MCP_SERVER_URL=
INTERVIEWFORGE_AMAZON_MCP_TOOL=search_amazon_company_knowledge

# Optional community LeetCode MCP server over Streamable HTTP.
# Example server project: https://github.com/jinzcdev/leetcode-mcp-server
# Start it locally with HTTP transport, review it first, then set:
INTERVIEWFORGE_LEETCODE_MCP_SERVER_URL=
INTERVIEWFORGE_LEETCODE_MCP_TOOL=search_problems
